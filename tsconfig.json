{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@memo/*": [
        "packages/*/src/index.ts"
      ],
      "@memo/contracts/pet-actions": [
        "packages/contracts/src/pet-actions.ts"
      ],
      "@memo/contracts/foundation": [
        "packages/contracts/src/foundation.ts"
      ],
      "@memo/storage/foundation": [
        "packages/storage/src/foundation/index.ts"
      ]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts"
  ]
}
