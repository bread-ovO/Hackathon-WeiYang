{
  "name": "@memo/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "description": "BUGU 不咕 · 工作事项与桌面陪伴助手",
  "author": "Project contributors",
  "scripts": {
    "dev": "node ../../scripts/build-pet-native.mjs && electron-vite dev",
    "build": "node ../../scripts/build-pet-native.mjs && electron-vite build",
    "rebuild:native": "electron-builder install-app-deps",
    "package:dir": "node ../../scripts/build-pet-native.mjs && electron-vite build && electron-builder --dir",
    "package:demo": "node ../../scripts/build-pet-native.mjs && electron-vite build && electron-builder --dir --config.directories.output=../../release/demo",
    "package:real": "node ../../scripts/build-pet-native.mjs && VITE_MEMO_NO_DEMO=1 electron-vite build && electron-builder --dir --config.directories.output=../../release/real",
    "package:dmg": "node ../../scripts/build-pet-native.mjs && electron-vite build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.13.2",
    "@memo/contracts": "workspace:*",
    "@memo/storage": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "ajv": "8.17.1",
    "better-sqlite3": "13.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@memo/application": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "electron": "44.3.0",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "vite": "7.3.1"
  },
  "build": {
    "appId": "dev.multisource.memo",
    "productName": "BUGU 不咕",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "out/native/**",
      "out/bundled-pet/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/icon.png"
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "npmRebuild": true,
    "win": {
      "icon": "build/icon.ico"
    },
    "beforePack": "../../scripts/bundle-default-pet.mjs",
    "afterPack": "../../scripts/verify-packaged-pet.mjs"
  }
}
