{
  "name": "@memo/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "description": "BUGU \u4e0d\u5495 \u00b7 \u5de5\u4f5c\u4e8b\u9879\u4e0e\u684c\u9762\u966a\u4f34\u52a9\u624b",
  "author": "Project contributors",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "rebuild:native": "electron-builder install-app-deps",
    "package:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.13.2",
    "@memo/contracts": "workspace:*",
    "@memo/storage": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "ajv": "8.17.1",
    "better-sqlite3": "13.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@memo/application": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "electron": "44.3.0",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "vite": "7.3.1"
  },
  "build": {
    "appId": "dev.multisource.memo",
    "productName": "BUGU \u4e0d\u5495",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null
    },
    "npmRebuild": true
  }
}
