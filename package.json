{
  "name": "bugu",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @memo/desktop dev",
    "build": "pnpm --filter @memo/desktop build",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:storage": "node scripts/test-storage.mjs",
    "test:desktop": "playwright test",
    "eval:extract": "node scripts/eval-extraction.mjs",
    "rebuild:native": "pnpm --filter @memo/desktop rebuild:native",
    "check": "pnpm check:boundaries && pnpm typecheck && pnpm test && pnpm build && pnpm test:storage && pnpm test:desktop",
    "package:dir": "pnpm --filter @memo/desktop package:dir",
    "package:demo": "pnpm --filter @memo/desktop package:demo",
    "package:real": "pnpm --filter @memo/desktop package:real",
    "package:dmg": "pnpm --filter @memo/desktop package:dmg",
    "package:release": "pnpm --filter @memo/desktop package:release",
    "start:demo": "node scripts/start-desktop.mjs --mode=demo",
    "start:real": "node scripts/start-desktop.mjs --mode=real"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/better-sqlite3": "7.6.13",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "esbuild": "0.25.12"
  }
}
